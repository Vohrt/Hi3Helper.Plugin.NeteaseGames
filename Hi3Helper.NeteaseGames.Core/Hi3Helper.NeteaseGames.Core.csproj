<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <Deterministic>true</Deterministic>
        <LangVersion>preview</LangVersion>
        <AssemblyName>NeteaseGames.Core</AssemblyName>
        <ProductName>NetEase Games Core Plugin Library</ProductName>
        <Product>Collapse</Product>
        <Description>Common core functionality (NetEase HEX_ manifest envelope, LCFG launcher config, mini-pack update protocol) for NetEase-published game plugins in Collapse Launcher</Description>
        <AssemblyTitle>NetEase Games Core Library</AssemblyTitle>
        <Company>CollapsePlugin</Company>
        <Authors>$(Company).</Authors>
        <Copyright>Copyright 2026 $(Company)</Copyright>
        <Version>0.1.0</Version>
        <Configurations>Debug;Release;DebugNoReflection;ReleaseNoReflection</Configurations>
        <Title>Hi3Helper.NeteaseGames.Core</Title>
        <!-- The plugin targets Windows only (Collapse is a Windows launcher), so the registry based
             installation discovery is always safe. -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <!-- Release builds ship without symbols (see the plugin csproj for the reason). -->
    <PropertyGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='ReleaseNoReflection'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='DebugNoReflection'">
        <DefineConstants>$(DefineConstants);DEBUG;USELIGHTWEIGHTJSONPARSER</DefineConstants>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='ReleaseNoReflection'">
        <DefineConstants>$(DefineConstants);USELIGHTWEIGHTJSONPARSER</DefineConstants>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>

    <!-- The official key visual of the game, used as the launcher background. -->
    <ItemGroup>
        <EmbeddedResource Include="background.jpg" LogicalName="background.jpg" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hi3Helper.NeteaseGames.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hi3Helper.Plugin.Core\Hi3Helper.Plugin.Core.csproj"/>
    </ItemGroup>

</Project>
